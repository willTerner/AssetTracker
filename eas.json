{
    "cli": {
        "version": ">= 16.25.1",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development"
        },
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "ABI_SPLIT": "true"
            }
        },
        "production": {
            "autoIncrement": true,
            "environment": "production",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "ABI_SPLIT": "true"
            }
        }
    },
    "submit": {
        "production": {}
    }
}